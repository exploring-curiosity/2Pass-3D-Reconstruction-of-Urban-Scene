import json
from pathlib import Path

import numpy as np
import pandas as pd

# ---------------------------------------------------------------
# Paths / constants
# ---------------------------------------------------------------
ROOT = Path(__file__).resolve().parents[2]  # repo root

OUT_DIR = ROOT / "outputs" / "pass2_dynamic"
PRIMS_PATH = OUT_DIR / "multi_camera_primitives.json"

MOTION_SUMMARY_PATH = OUT_DIR / "s1-left_motion_summary.json"

RESULTS_DIR = ROOT / "experiments" / "results"
RESULTS_DIR.mkdir(parents=True, exist_ok=True)

LOS_CSV = RESULTS_DIR / "los_metrics.csv"
OUT_CSV = RESULTS_DIR / "baseline_comparison.csv"


# ---------------------------------------------------------------
# Helper: load FPS from any motion summary
# ---------------------------------------------------------------
def load_fps():
    if not MOTION_SUMMARY_PATH.exists():
        raise FileNotFoundError(f"Cannot find motion summary: {MOTION_SUMMARY_PATH}")
    with open(MOTION_SUMMARY_PATH, "r") as f:
        data = json.load(f)
    fps = float(data["fps"])
    print(f"[info] Using FPS = {fps:.4f} from {MOTION_SUMMARY_PATH.name}")
    return fps


# ---------------------------------------------------------------
# Main
# ---------------------------------------------------------------
def main():
    fps = load_fps()

    if not PRIMS_PATH.exists():
        raise FileNotFoundError(f"Cannot find multi-camera primitives: {PRIMS_PATH}")
    with open(PRIMS_PATH, "r") as f:
        primitives = json.load(f)

    if not LOS_CSV.exists():
        raise FileNotFoundError(
            f"LoS metrics CSV not found: {LOS_CSV}. "
            "Run eval_los_and_baselines.py (LoS part) first."
        )
    los_df = pd.read_csv(LOS_CSV)

    rows = []

    for obj in primitives:
        obj_id = obj.get("id")
        cls = obj.get("class_name", "unknown")
        cat = obj.get("category", "unknown")

        # We only do baselines for pedestrians as per the spec
        if cat != "person":
            continue

        members = obj.get("members", [])
        if not members:
            continue

        # -----------------------------------------------------------
        # Single-camera baseline (Baseline A)
        # -----------------------------------------------------------
        cam_stats = {}  # camera_id -> dict(first_frame, last_frame)

        for m in members:
            cid = m.get("camera_id")
            if cid is None:
                continue

            # Use per-member times if available, else fall back to object times
            s = float(m.get("start_time_sec", obj.get("start_time_sec", 0.0)))
            e = float(m.get("end_time_sec", obj.get("end_time_sec", s)))

            f_start = int(round(s * fps))
            f_end = int(round(e * fps))

            if cid not in cam_stats:
                cam_stats[cid] = {"first": f_start, "last": f_end}
            else:
                cam_stats[cid]["first"] = min(cam_stats[cid]["first"], f_start)
                cam_stats[cid]["last"] = max(cam_stats[cid]["last"], f_end)

        if not cam_stats:
            # No usable camera spans
            continue

        # Global span for the object across all cameras
        global_first = min(d["first"] for d in cam_stats.values())
        global_last = max(d["last"] for d in cam_stats.values())
        global_span_frames = max(1, global_last - global_first + 1)

        # Choose the best camera = longest temporal coverage
        def span_len(d):
            return d["last"] - d["first"] + 1

        best_cid, best_stats = max(cam_stats.items(), key=lambda kv: span_len(kv[1]))
        best_span_frames = span_len(best_stats)

        first_single = int(best_stats["first"])
        vis_single = float(best_span_frames) / float(global_span_frames)

        # -----------------------------------------------------------
        # LoS-based multi-view metrics
        # -----------------------------------------------------------
        los_rows = los_df[los_df["object_id"] == obj_id]

        if los_rows.empty:
            first_los = -1
            vis_los = 0.0
        else:
            valid = los_rows[los_rows["first_visible_frame"] >= 0]
            if valid.empty:
                first_los = -1
                vis_los = 0.0
            else:
                first_los = int(valid["first_visible_frame"].min())
                # approximate: best per-camera visibility ≈ multi-view visibility
                vis_los = float(valid["visibility_fraction"].max())

        # -----------------------------------------------------------
        # Baseline B slots (2D occlusion heuristic)
        # We'll fill these later if you implement the 2D logic.
        # For now we set them to NaN.
        # -----------------------------------------------------------
        first_2d = np.nan
        vis_2d = np.nan

        rows.append(
            {
                "object_id": obj_id,
                "class_name": cls,
                "first_single": first_single,
                "vis_single": vis_single,
                "first_2d": first_2d,
                "vis_2d": vis_2d,
                "first_los": first_los,
                "vis_los": vis_los,
            }
        )

    df = pd.DataFrame(rows)
    df.to_csv(OUT_CSV, index=False)
    print(f"[info] Saved baseline comparison to: {OUT_CSV}")

    if not df.empty:
        print("\n=== Baseline vs LoS summary (pedestrians only) ===")
        print(f"Num pedestrian objects: {len(df)}")

        has_los = df["first_los"] >= 0
        df_los = df[has_los]

        if not df_los.empty:
            diff_frames = df_los["first_single"] - df_los["first_los"]
            mean_improve_frames = diff_frames.mean()
            mean_improve_sec = mean_improve_frames / fps
            print(
                f"Mean earlier detection (LoS vs single-camera): "
                f"{mean_improve_frames:.2f} frames ({mean_improve_sec:.3f} s)"
            )

            vis_gain = df_los["vis_los"] - df_los["vis_single"]
            print(
                f"Mean visibility gain (LoS - single-camera): {vis_gain.mean():.3f}"
            )
        else:
            print("No objects with valid LoS first-visible frame.")


if __name__ == "__main__":
    main()
